<?xml version="1.0" ?>
<!-- Starting settings for CoreELEC's settings add-on in JellyELEC images: its first-run
     wizard is marked done, Wake-on-LAN is on (matching config.ini on the boot partition),
     p3i's automatic updates are off, and the box is named JellyELEC (the settings add-on
     applies this name at every start; JellyELEC's setup and Settings keep it up to date). -->
<coreelec>
	<addon_config/>
	<settings>
		<system>
			<wizard_completed>True</wizard_completed>
			<hostname>JellyELEC</hostname>
		</system>
		<connman>
			<wizard_completed>True</wizard_completed>
		</connman>
		<services>
			<wizard_completed>True</wizard_completed>
		</services>
		<about>
			<wizard_completed>True</wizard_completed>
		</about>
		<coreelec>
			<wizard_completed>True</wizard_completed>
		</coreelec>
		<hardware>
			<wol>on</wol>
		</hardware>
		<updates>
			<AutoUpdate>manual</AutoUpdate>
		</updates>
	</settings>
</coreelec>
