<?xml version="1.0" ?>
<!-- Starting settings for CoreELEC's settings add-on in JellyELEC images: its first-run
     wizard is marked done, and p3i's automatic updates are off. (The box's network name
     is set by JellyELEC's setup: see box_name.py in the add-on.) -->
<coreelec>
	<addon_config/>
	<settings>
		<system>
			<wizard_completed>True</wizard_completed>
		</system>
		<connman>
			<wizard_completed>True</wizard_completed>
		</connman>
		<services>
			<wizard_completed>True</wizard_completed>
		</services>
		<about>
			<wizard_completed>True</wizard_completed>
		</about>
		<coreelec>
			<wizard_completed>True</wizard_completed>
		</coreelec>
		<updates>
			<AutoUpdate>manual</AutoUpdate>
		</updates>
	</settings>
</coreelec>
