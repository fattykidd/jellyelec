<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC: Kodi's startup screen, replacing the skin's own.

    The skin's version switches straight to Kodi's home screen. This one stays on the
    JellyELEC splash until JellyELEC opens over it, so the home screen is never seen at
    boot. JellyELEC's service switches to the home screen itself when it's needed: with
    appliance mode off, or after Exit to Kodi.

    OK on this screen also opens Kodi's home screen, in case JellyELEC can't start.
-->
<window>
    <onload>SetProperty(jellyelec.startup_screen,true,home)</onload>
    <defaultcontrol always="true">10</defaultcontrol>
    <backgroundcolor>0xFF101418</backgroundcolor>
    <controls>
        <!-- The JellyELEC splash, layer by layer (built by tools/make_splash.py from artwork/):
             the ocean; light rays shimmering; the triangle's glow breathing; the jellyfish
             bobbing and pulsing; the wordmark. Every animation starts from the still splash's
             look, so the boot splash hands over without a jump. The same layers are in
             jellyelec-splash.xml (add-on) and image/skin/Startup.xml. -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-ocean.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-rays.png</texture>
            <animation effect="fade" start="100" end="35" time="5200" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-triangle.png</texture>
            <animation effect="fade" start="100" end="78" time="3400" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-jellyfish.png</texture>
            <animation effect="slide" end="0,-26" time="4600" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
            <animation effect="zoom" end="103" center="960,370" time="1700" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-wordmark.png</texture>
        </control>
        <control type="button" id="10">
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>
            <texturefocus />
            <texturenofocus />
            <onclick>ReplaceWindow(home)</onclick>
        </control>
    </controls>
</window>
