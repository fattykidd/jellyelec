<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC: Kodi's startup screen, replacing the skin's own.

    The skin's version switches straight to Kodi's home screen. This one stays on the
    JellyELEC splash until JellyELEC opens over it, so the home screen is never seen at
    boot. JellyELEC's service switches to the home screen itself when it's needed: with
    appliance mode off, or after Exit to Kodi.

    OK on this screen also opens Kodi's home screen, in case JellyELEC can't start.
-->
<window>
    <onload>SetProperty(jellyelec.startup_screen,true,home)</onload>
    <defaultcontrol always="true">10</defaultcontrol>
    <backgroundcolor>0xFF101418</backgroundcolor>
    <controls>
        <!-- Jellyfish, drifting and pulsing behind the wordmark. Their places match the still
             splash drawn by tools/make_splash.py (JELLYFISH_PLACES), and every animation starts
             from that position, so the still splash hands over without a jump. The same
             controls are in jellyelec-splash.xml (add-on) and image/skin/Startup.xml. -->
        <control type="image">
            <left>250</left>
            <top>330</top>
            <width>225</width>
            <height>360</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-jellyfish.png</texture>
            <animation effect="slide" end="0,-50" time="4600" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
            <animation effect="zoom" end="104" center="362,420" time="1500" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>1430</left>
            <top>130</top>
            <width>270</width>
            <height>432</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-jellyfish.png</texture>
            <animation effect="slide" end="0,-70" time="5400" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
            <animation effect="zoom" end="104" center="1565,238" time="1800" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>1110</left>
            <top>640</top>
            <width>150</width>
            <height>240</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-jellyfish.png</texture>
            <animation effect="slide" end="0,-40" time="3800" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
            <animation effect="zoom" end="104" center="1185,700" time="1300" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>special://xbmc/addons/script.jellyelec/resources/skins/Default/media/jellyelec-wordmark.png</texture>
        </control>
        <control type="button" id="10">
            <left>0</left>
            <top>0</top>
            <width>1</width>
            <height>1</height>
            <texturefocus />
            <texturenofocus />
            <onclick>ReplaceWindow(home)</onclick>
        </control>
    </controls>
</window>
