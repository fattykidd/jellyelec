<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC first-run setup: one screen, reused for every step.
    Control IDs here must match the constants in resources/lib/setup.py:
      901-903  the step's options, top to bottom (unused ones are hidden)
    The heading, title, body and option labels are filled by setup.py through window properties.
-->
<window>
    <defaultcontrol always="true">901</defaultcontrol>
    <controls>

        <!-- Full-screen backing -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>jellyelec-white.png</texture>
            <colordiffuse>FF101418</colordiffuse>
        </control>

        <control type="group">
            <left>360</left>
            <top>200</top>

            <control type="label">
                <left>0</left>
                <top>0</top>
                <width>1200</width>
                <height>40</height>
                <textcolor>FFAA5CC3</textcolor>
                <label>$INFO[Window.Property(heading)]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>45</top>
                <width>1200</width>
                <height>70</height>
                <font>font45</font>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(title)]</label>
            </control>
            <control type="image">
                <left>0</left>
                <top>130</top>
                <width>120</width>
                <height>4</height>
                <texture>jellyelec-white.png</texture>
                <colordiffuse>FFAA5CC3</colordiffuse>
            </control>
            <control type="textbox">
                <left>0</left>
                <top>165</top>
                <width>1200</width>
                <height>300</height>
                <textcolor>FFCFD6DE</textcolor>
                <label>$INFO[Window.Property(body)]</label>
            </control>

            <!-- The options. A grouplist closes up the gaps left by hidden buttons. -->
            <control type="grouplist" id="950">
                <left>0</left>
                <top>490</top>
                <width>700</width>
                <height>240</height>
                <itemgap>16</itemgap>
                <orientation>vertical</orientation>

                <control type="button" id="901">
                    <width>700</width>
                    <height>64</height>
                    <textoffsetx>30</textoffsetx>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(option1)]</label>
                    <textcolor>FFCFD6DE</textcolor>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <texturenofocus colordiffuse="33FFFFFF">jellyelec-white.png</texturenofocus>
                    <texturefocus colordiffuse="FFAA5CC3">jellyelec-white.png</texturefocus>
                    <visible>!String.IsEmpty(Window.Property(option1))</visible>
                </control>
                <control type="button" id="902">
                    <width>700</width>
                    <height>64</height>
                    <textoffsetx>30</textoffsetx>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(option2)]</label>
                    <textcolor>FFCFD6DE</textcolor>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <texturenofocus colordiffuse="33FFFFFF">jellyelec-white.png</texturenofocus>
                    <texturefocus colordiffuse="FFAA5CC3">jellyelec-white.png</texturefocus>
                    <visible>!String.IsEmpty(Window.Property(option2))</visible>
                </control>
                <control type="button" id="903">
                    <width>700</width>
                    <height>64</height>
                    <textoffsetx>30</textoffsetx>
                    <aligny>center</aligny>
                    <label>$INFO[Window.Property(option3)]</label>
                    <textcolor>FFCFD6DE</textcolor>
                    <focusedcolor>FFFFFFFF</focusedcolor>
                    <texturenofocus colordiffuse="33FFFFFF">jellyelec-white.png</texturenofocus>
                    <texturefocus colordiffuse="FFAA5CC3">jellyelec-white.png</texturefocus>
                    <visible>!String.IsEmpty(Window.Property(option3))</visible>
                </control>
            </control>
        </control>

    </controls>
</window>
