<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC backdrop, open behind every other JellyELEC screen (see resources/lib/splash.py).
    The status line is filled by splash.py through the "status" window property.
-->
<window>
    <backgroundcolor>0xFF101418</backgroundcolor>
    <controls>

        <!-- The same picture as the boot and Kodi splash screens, so nothing jumps -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>jellyelec-splash.png</texture>
        </control>

        <control type="label">
            <left>0</left>
            <top>690</top>
            <width>1920</width>
            <height>40</height>
            <align>center</align>
            <textcolor>FF6B7480</textcolor>
            <label>$INFO[Window.Property(status)]</label>
        </control>

    </controls>
</window>
