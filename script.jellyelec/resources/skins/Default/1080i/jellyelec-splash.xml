<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC backdrop, open behind every other JellyELEC screen (see resources/lib/splash.py).
    The status line is filled by splash.py through the "status" window property.
-->
<window>
    <backgroundcolor>0xFF101418</backgroundcolor>
    <controls>

        <!-- The JellyELEC splash, layer by layer (built by tools/make_splash.py from artwork/):
             the ocean; light rays shimmering; the triangle's glow breathing; the jellyfish
             bobbing and pulsing; the wordmark. Every animation starts from the still splash's
             look, so the boot splash hands over without a jump. The same layers are in
             jellyelec-splash.xml (add-on) and image/skin/Startup.xml. -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>jellyelec-ocean.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>jellyelec-rays.png</texture>
            <animation effect="fade" start="100" end="35" time="5200" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>jellyelec-triangle.png</texture>
            <animation effect="fade" start="100" end="78" time="3400" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>jellyelec-jellyfish.png</texture>
            <animation effect="slide" end="0,-26" time="4600" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
            <animation effect="zoom" end="103" center="960,370" time="1700" tween="sine" easing="inout" pulse="true" condition="true">Conditional</animation>
        </control>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>jellyelec-wordmark.png</texture>
        </control>

        <control type="label">
            <left>0</left>
            <top>1000</top>
            <width>1920</width>
            <height>40</height>
            <align>center</align>
            <textcolor>FF6B7480</textcolor>
            <label>$INFO[Window.Property(status)]</label>
        </control>

    </controls>
</window>
