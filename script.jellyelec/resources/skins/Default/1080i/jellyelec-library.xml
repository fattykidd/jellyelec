<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC library grid: every movie or show in one library, A to Z, in the home screen's
    look: the focused title's fanart fading in on the right, its clearlogo (or title) and
    details on the left, and rounded posters with a purple ring on focus.
    Control IDs here must match the constants in resources/lib/library.py:
      500  poster grid
-->
<window>
    <defaultcontrol always="true">500</defaultcontrol>
    <backgroundcolor>0xFF0B0C11</backgroundcolor>
    <controls>

        <!-- Fanart of the focused title, fading into the background on the left and below -->
        <control type="image">
            <left>580</left>
            <top>0</top>
            <width>1340</width>
            <height>620</height>
            <aspectratio>scale</aspectratio>
            <colordiffuse>D9FFFFFF</colordiffuse>
            <fadetime>400</fadetime>
            <texture background="true">$INFO[Container(500).ListItem.Art(fanart)]</texture>
        </control>
        <control type="image">
            <left>580</left>
            <top>0</top>
            <width>1340</width>
            <height>620</height>
            <texture>jellyelec-fade-left.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>300</top>
            <width>1920</width>
            <height>322</height>
            <texture>jellyelec-fade-bottom.png</texture>
        </control>

        <!-- Top bar: library name, position in it, clock -->
        <control type="label">
            <left>96</left>
            <top>40</top>
            <width>1100</width>
            <height>64</height>
            <aligny>center</aligny>
            <font>JE_Brand</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>$INFO[Window.Property(library_name)]</label>
        </control>
        <control type="label">
            <left>1210</left>
            <top>40</top>
            <width>320</width>
            <height>64</height>
            <align>right</align>
            <aligny>center</aligny>
            <font>JE_Label</font>
            <textcolor>FF8D90A0</textcolor>
            <label>$INFO[Container(500).CurrentItem]$INFO[Window.Property(item_count), of ,]</label>
        </control>
        <control type="label">
            <left>1540</left>
            <top>40</top>
            <width>284</width>
            <height>64</height>
            <align>right</align>
            <aligny>center</aligny>
            <font>JE_Clock</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>$INFO[System.Time]</label>
        </control>

        <!-- The focused title: clearlogo (or name), details with Ends at, resolution and
             audio (filled in by library.py once focus rests), and the start of the plot -->
        <control type="group">
            <left>96</left>
            <top>118</top>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>560</width>
                <height>108</height>
                <aspectratio align="left" aligny="center">keep</aspectratio>
                <fadetime>300</fadetime>
                <texture background="true">$INFO[Container(500).ListItem.Art(clearlogo)]</texture>
                <visible>!String.IsEmpty(Container(500).ListItem.Art(clearlogo))</visible>
            </control>
            <control type="label">
                <left>0</left>
                <top>0</top>
                <width>1000</width>
                <height>108</height>
                <aligny>center</aligny>
                <font>JE_Title</font>
                <textcolor>FFF2F2F5</textcolor>
                <label>$INFO[Container(500).ListItem.Label]</label>
                <visible>String.IsEmpty(Container(500).ListItem.Art(clearlogo))</visible>
            </control>
            <control type="label">
                <left>0</left>
                <top>118</top>
                <width>1100</width>
                <height>36</height>
                <font>JE_Label</font>
                <textcolor>FFD5D6DE</textcolor>
                <label>$INFO[Container(500).ListItem.Property(meta)]$INFO[Window.Property(focused_ends),  ·  ,]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>156</top>
                <width>1100</width>
                <height>36</height>
                <font>JE_LabelBold</font>
                <textcolor>FFF2F2F5</textcolor>
                <label>$INFO[Window.Property(focused_media)]</label>
            </control>
            <!-- The same details as badges (Settings > Media details); one of the two is empty -->
            <control type="grouplist">
                <left>0</left>
                <top>156</top>
                <width>1100</width>
                <height>36</height>
                <orientation>horizontal</orientation>
                <itemgap>10</itemgap>
                    <control type="button">
                        <width min="44" max="420">auto</width>
                        <height>36</height>
                        <textoffsetx>12</textoffsetx>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>JE_Kicker</font>
                        <textcolor>FFF2F2F5</textcolor>
                        <disabledcolor>FFF2F2F5</disabledcolor>
                        <texturenofocus border="10" colordiffuse="99F2F2F5">jellyelec-badge.png</texturenofocus>
                        <texturefocus border="10" colordiffuse="99F2F2F5">jellyelec-badge.png</texturefocus>
                        <enable>false</enable>
                        <label>$INFO[Window.Property(focused_badge_1)]</label>
                        <visible>!String.IsEmpty(Window.Property(focused_badge_1))</visible>
                    </control>
                    <control type="button">
                        <width min="44" max="420">auto</width>
                        <height>36</height>
                        <textoffsetx>12</textoffsetx>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>JE_Kicker</font>
                        <textcolor>FFF2F2F5</textcolor>
                        <disabledcolor>FFF2F2F5</disabledcolor>
                        <texturenofocus border="10" colordiffuse="99F2F2F5">jellyelec-badge.png</texturenofocus>
                        <texturefocus border="10" colordiffuse="99F2F2F5">jellyelec-badge.png</texturefocus>
                        <enable>false</enable>
                        <label>$INFO[Window.Property(focused_badge_2)]</label>
                        <visible>!String.IsEmpty(Window.Property(focused_badge_2))</visible>
                    </control>
                    <control type="button">
                        <width min="44" max="420">auto</width>
                        <height>36</height>
                        <textoffsetx>12</textoffsetx>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>JE_Kicker</font>
                        <textcolor>FFF2F2F5</textcolor>
                        <disabledcolor>FFF2F2F5</disabledcolor>
                        <texturenofocus border="10" colordiffuse="99F2F2F5">jellyelec-badge.png</texturenofocus>
                        <texturefocus border="10" colordiffuse="99F2F2F5">jellyelec-badge.png</texturefocus>
                        <enable>false</enable>
                        <label>$INFO[Window.Property(focused_badge_3)]</label>
                        <visible>!String.IsEmpty(Window.Property(focused_badge_3))</visible>
                    </control>
                    <control type="button">
                        <width min="44" max="420">auto</width>
                        <height>36</height>
                        <textoffsetx>12</textoffsetx>
                        <align>center</align>
                        <aligny>center</aligny>
                        <font>JE_Kicker</font>
                        <textcolor>FFF2F2F5</textcolor>
                        <disabledcolor>FFF2F2F5</disabledcolor>
                        <texturenofocus border="10" colordiffuse="99F2F2F5">jellyelec-badge.png</texturenofocus>
                        <texturefocus border="10" colordiffuse="99F2F2F5">jellyelec-badge.png</texturefocus>
                        <enable>false</enable>
                        <label>$INFO[Window.Property(focused_badge_4)]</label>
                        <visible>!String.IsEmpty(Window.Property(focused_badge_4))</visible>
                    </control>
            </control>
            <control type="textbox">
                <left>0</left>
                <top>198</top>
                <width>860</width>
                <height>74</height>
                <font>JE_Body</font>
                <textcolor>FFC3C5D0</textcolor>
                <label>$INFO[Container(500).ListItem.Plot]</label>
            </control>
        </control>

        <!-- Poster grid: two rows in view, scrolling a row at a time -->
        <control type="panel" id="500">
            <left>84</left>
            <top>396</top>
            <width>1836</width>
            <height>684</height>
            <orientation>vertical</orientation>
            <scrolltime tween="cubic" easing="out">240</scrolltime>
            <itemlayout width="204" height="330">
                <control type="image">
                    <left>12</left>
                    <top>16</top>
                    <width>180</width>
                    <height>270</height>
                    <aspectratio>scale</aspectratio>
                    <colordiffuse>D9FFFFFF</colordiffuse>
                    <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <!-- A collection showing a borrowed movie poster: darkened, with its own name -->
                <control type="group">
                    <visible>String.IsEqual(ListItem.Property(borrowed_poster),true)</visible>
                    <control type="image">
                        <left>12</left>
                        <top>16</top>
                        <width>180</width>
                        <height>270</height>
                        <texture diffuse="jellyelec-mask-poster.png">jellyelec-fade-bottom.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left>
                        <top>176</top>
                        <width>156</width>
                        <height>24</height>
                        <align>center</align>
                        <font>JE_Kicker</font>
                        <textcolor>FFC99BDA</textcolor>
                        <label>COLLECTION</label>
                    </control>
                    <control type="textbox">
                        <left>22</left>
                        <top>200</top>
                        <width>160</width>
                        <height>80</height>
                        <align>center</align>
                        <font>JE_TitleSmall</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </control>
            </itemlayout>
            <focusedlayout width="204" height="330">
                <control type="image">
                    <left>4</left>
                    <top>8</top>
                    <width>196</width>
                    <height>286</height>
                    <texture border="18">jellyelec-ring.png</texture>
                    <colordiffuse>FFAA5CC3</colordiffuse>
                </control>
                <control type="image">
                    <left>12</left>
                    <top>16</top>
                    <width>180</width>
                    <height>270</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <!-- A collection showing a borrowed movie poster: darkened, with its own name -->
                <control type="group">
                    <visible>String.IsEqual(ListItem.Property(borrowed_poster),true)</visible>
                    <control type="image">
                        <left>12</left>
                        <top>16</top>
                        <width>180</width>
                        <height>270</height>
                        <texture diffuse="jellyelec-mask-poster.png">jellyelec-fade-bottom.png</texture>
                    </control>
                    <control type="label">
                        <left>24</left>
                        <top>176</top>
                        <width>156</width>
                        <height>24</height>
                        <align>center</align>
                        <font>JE_Kicker</font>
                        <textcolor>FFC99BDA</textcolor>
                        <label>COLLECTION</label>
                    </control>
                    <control type="textbox">
                        <left>22</left>
                        <top>200</top>
                        <width>160</width>
                        <height>80</height>
                        <align>center</align>
                        <font>JE_TitleSmall</font>
                        <textcolor>FFFFFFFF</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </control>
            </focusedlayout>
        </control>

    </controls>
</window>
