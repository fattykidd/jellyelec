<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC home screen (v2 look: library bar on top, spotlight, fanart fading in on the right).
    Control IDs here must match the constants in resources/lib/home.py:
      100  library bar
      110  Settings button
      150  scrolling stack of rows
      200  Continue Watching row
      205  Next Up row (TV libraries only)
      210  Recently Added row
      220  Random row
    The spotlight is filled by home.py through window properties (spot_*).
    Fonts named JE_* come with the JellyELEC image; elsewhere Kodi uses its default font.
-->
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <backgroundcolor>0xFF0B0C11</backgroundcolor>
    <controls>

        <!-- Fanart of whatever the spotlight shows, fading into the background on the left and below -->
        <control type="image">
            <left>580</left>
            <top>0</top>
            <width>1340</width>
            <height>760</height>
            <aspectratio>scale</aspectratio>
            <colordiffuse>D9FFFFFF</colordiffuse>
            <fadetime>400</fadetime>
            <texture background="true">$INFO[Window.Property(spot_backdrop)]</texture>
        </control>
        <control type="image">
            <left>580</left>
            <top>0</top>
            <width>1340</width>
            <height>760</height>
            <texture>jellyelec-fade-left.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>420</top>
            <width>1920</width>
            <height>342</height>
            <texture>jellyelec-fade-bottom.png</texture>
        </control>

        <!-- Top bar: wordmark, libraries, weather, clock and Settings -->
        <control type="label">
            <left>96</left>
            <top>40</top>
            <width>200</width>
            <height>64</height>
            <aligny>center</aligny>
            <font>JE_Brand</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>Jelly[COLOR FFAA5CC3]ELEC[/COLOR]</label>
        </control>

        <control type="list" id="100">
            <left>300</left>
            <top>40</top>
            <width>1000</width>
            <height>64</height>
            <orientation>horizontal</orientation>
            <onright>110</onright>
            <ondown>150</ondown>
            <scrolltime tween="cubic" easing="out">200</scrolltime>
            <itemlayout width="200" height="64">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>200</width>
                    <height>64</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>JE_Label</font>
                    <textcolor>FFB7B9C6</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="200" height="64">
                <!-- Focused: a white pill. Selected but not focused: an accent underline. -->
                <control type="image">
                    <left>4</left>
                    <top>4</top>
                    <width>192</width>
                    <height>56</height>
                    <texture border="28">jellyelec-pill.png</texture>
                    <colordiffuse>FFF2F2F5</colordiffuse>
                    <visible>Control.HasFocus(100)</visible>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>200</width>
                    <height>64</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>JE_Label</font>
                    <textcolor>FF0B0C11</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>Control.HasFocus(100)</visible>
                </control>
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>200</width>
                    <height>64</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <font>JE_Label</font>
                    <textcolor>FFF2F2F5</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                    <visible>!Control.HasFocus(100)</visible>
                </control>
                <control type="image">
                    <left>60</left>
                    <top>56</top>
                    <width>80</width>
                    <height>4</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FFAA5CC3</colordiffuse>
                    <visible>!Control.HasFocus(100)</visible>
                </control>
            </focusedlayout>
        </control>

        <control type="label">
            <left>1310</left>
            <top>40</top>
            <width>220</width>
            <height>64</height>
            <align>right</align>
            <aligny>center</aligny>
            <font>JE_Label</font>
            <textcolor>FFD5D6DE</textcolor>
            <label>$INFO[Weather.Temperature]$INFO[Weather.Conditions,  ·  ]</label>
            <visible>Weather.IsFetched</visible>
        </control>
        <control type="label">
            <left>1540</left>
            <top>40</top>
            <width>190</width>
            <height>64</height>
            <align>right</align>
            <aligny>center</aligny>
            <font>JE_Clock</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>$INFO[System.Time]</label>
        </control>

        <control type="button" id="110">
            <left>1764</left>
            <top>42</top>
            <width>60</width>
            <height>60</height>
            <label></label>
            <texturefocus colordiffuse="FFAA5CC3">jellyelec-pill.png</texturefocus>
            <texturenofocus colordiffuse="17FFFFFF">jellyelec-pill.png</texturenofocus>
            <onleft>100</onleft>
            <ondown>150</ondown>
        </control>
        <control type="image">
            <left>1776</left>
            <top>54</top>
            <width>36</width>
            <height>36</height>
            <texture>jellyelec-icon-settings.png</texture>
            <colordiffuse>FFD5D6DE</colordiffuse>
            <visible>!Control.HasFocus(110)</visible>
        </control>
        <control type="image">
            <left>1776</left>
            <top>54</top>
            <width>36</width>
            <height>36</height>
            <texture>jellyelec-icon-settings.png</texture>
            <colordiffuse>FFFFFFFF</colordiffuse>
            <visible>Control.HasFocus(110)</visible>
        </control>

        <!-- Spotlight: whatever is focused, or the first item of the library when the bar is -->
        <control type="group">
            <left>96</left>
            <top>170</top>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>720</width>
                <height>170</height>
                <aspectratio align="left" aligny="center">keep</aspectratio>
                <fadetime>300</fadetime>
                <texture background="true">$INFO[Window.Property(spot_logo)]</texture>
                <visible>!String.IsEmpty(Window.Property(spot_logo))</visible>
            </control>
            <control type="label">
                <left>0</left>
                <top>0</top>
                <width>820</width>
                <height>170</height>
                <aligny>center</aligny>
                <wrapmultiline>true</wrapmultiline>
                <font>JE_Title</font>
                <textcolor>FFF2F2F5</textcolor>
                <label>$INFO[Window.Property(spot_title)]</label>
                <visible>String.IsEmpty(Window.Property(spot_logo))</visible>
            </control>
            <control type="label">
                <left>0</left>
                <top>186</top>
                <width>1100</width>
                <height>36</height>
                <font>JE_Label</font>
                <textcolor>FFD5D6DE</textcolor>
                <label>$INFO[Window.Property(spot_meta)]</label>
            </control>
            <control type="textbox">
                <left>0</left>
                <top>236</top>
                <width>860</width>
                <height>176</height>
                <autoscroll delay="6000" time="4000" repeat="8000">true</autoscroll>
                <font>JE_Body</font>
                <textcolor>FFC3C5D0</textcolor>
                <label>$INFO[Window.Property(spot_plot)]</label>
            </control>
        </control>

        <!-- Shown when every row is empty -->
        <control type="label">
            <left>96</left>
            <top>640</top>
            <width>1200</width>
            <height>40</height>
            <font>JE_Label</font>
            <textcolor>FF8D90A0</textcolor>
            <label>$INFO[Window.Property(empty_message)]</label>
            <visible>Integer.IsEqual(Container(200).NumItems,0) + Integer.IsEqual(Container(205).NumItems,0) + Integer.IsEqual(Container(210).NumItems,0) + Integer.IsEqual(Container(220).NumItems,0)</visible>
        </control>

        <!-- Stack of rows, one row tall: the focused row always sits here, and the row above slides
         up out of view behind the spotlight. Empty rows are hidden. -->
        <control type="grouplist" id="150">
            <left>0</left>
            <top>730</top>
            <width>1920</width>
            <height>350</height>
            <orientation>vertical</orientation>
            <itemgap>0</itemgap>
            <onup>100</onup>
            <scrolltime tween="cubic" easing="out">220</scrolltime>

            <control type="group">
                <width>1920</width>
                <height>350</height>
                <visible>Integer.IsGreater(Container(200).NumItems,0)</visible>
                <control type="label">
                    <left>96</left>
                    <top>0</top>
                    <width>900</width>
                    <height>40</height>
                    <font>JE_Heading</font>
                    <textcolor>FFF2F2F5</textcolor>
                    <label>Continue watching</label>
                </control>
                <control type="list" id="200">
                    <onup>100</onup>
                    <ondown>205</ondown>
                    <left>84</left>
                    <top>40</top>
                    <width>1836</width>
                    <height>306</height>
                    <orientation>horizontal</orientation>
                    <scrolltime tween="cubic" easing="out">220</scrolltime>
                    <itemlayout width="204" height="306">
                        <control type="image">
                            <left>12</left>
                            <top>16</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <colordiffuse>D9FFFFFF</colordiffuse>
                            <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout width="204" height="306">
                        <control type="image">
                            <left>4</left>
                            <top>8</top>
                            <width>196</width>
                            <height>286</height>
                            <texture border="18">jellyelec-ring.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(200)</visible>
                        </control>
                        <control type="image">
                            <left>12</left>
                            <top>16</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </focusedlayout>
                </control>
            </control>

            <control type="group">
                <width>1920</width>
                <height>350</height>
                <visible>Integer.IsGreater(Container(205).NumItems,0)</visible>
                <control type="label">
                    <left>96</left>
                    <top>0</top>
                    <width>900</width>
                    <height>40</height>
                    <font>JE_Heading</font>
                    <textcolor>FFF2F2F5</textcolor>
                    <label>Next up</label>
                </control>
                <control type="list" id="205">
                    <onup>200</onup>
                    <ondown>210</ondown>
                    <left>84</left>
                    <top>40</top>
                    <width>1836</width>
                    <height>306</height>
                    <orientation>horizontal</orientation>
                    <scrolltime tween="cubic" easing="out">220</scrolltime>
                    <itemlayout width="204" height="306">
                        <control type="image">
                            <left>12</left>
                            <top>16</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <colordiffuse>D9FFFFFF</colordiffuse>
                            <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout width="204" height="306">
                        <control type="image">
                            <left>4</left>
                            <top>8</top>
                            <width>196</width>
                            <height>286</height>
                            <texture border="18">jellyelec-ring.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(205)</visible>
                        </control>
                        <control type="image">
                            <left>12</left>
                            <top>16</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </focusedlayout>
                </control>
            </control>

            <control type="group">
                <width>1920</width>
                <height>350</height>
                <visible>Integer.IsGreater(Container(210).NumItems,0)</visible>
                <control type="label">
                    <left>96</left>
                    <top>0</top>
                    <width>900</width>
                    <height>40</height>
                    <font>JE_Heading</font>
                    <textcolor>FFF2F2F5</textcolor>
                    <label>Recently added</label>
                </control>
                <control type="list" id="210">
                    <onup>205</onup>
                    <ondown>220</ondown>
                    <left>84</left>
                    <top>40</top>
                    <width>1836</width>
                    <height>306</height>
                    <orientation>horizontal</orientation>
                    <scrolltime tween="cubic" easing="out">220</scrolltime>
                    <itemlayout width="204" height="306">
                        <control type="image">
                            <left>12</left>
                            <top>16</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <colordiffuse>D9FFFFFF</colordiffuse>
                            <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout width="204" height="306">
                        <control type="image">
                            <left>4</left>
                            <top>8</top>
                            <width>196</width>
                            <height>286</height>
                            <texture border="18">jellyelec-ring.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(210)</visible>
                        </control>
                        <control type="image">
                            <left>12</left>
                            <top>16</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </focusedlayout>
                </control>
            </control>

            <control type="group">
                <width>1920</width>
                <height>350</height>
                <visible>Integer.IsGreater(Container(220).NumItems,0)</visible>
                <control type="label">
                    <left>96</left>
                    <top>0</top>
                    <width>900</width>
                    <height>40</height>
                    <font>JE_Heading</font>
                    <textcolor>FFF2F2F5</textcolor>
                    <label>Random</label>
                </control>
                <control type="list" id="220">
                    <onup>210</onup>
                    <left>84</left>
                    <top>40</top>
                    <width>1836</width>
                    <height>306</height>
                    <orientation>horizontal</orientation>
                    <scrolltime tween="cubic" easing="out">220</scrolltime>
                    <itemlayout width="204" height="306">
                        <control type="image">
                            <left>12</left>
                            <top>16</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <colordiffuse>D9FFFFFF</colordiffuse>
                            <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout width="204" height="306">
                        <control type="image">
                            <left>4</left>
                            <top>8</top>
                            <width>196</width>
                            <height>286</height>
                            <texture border="18">jellyelec-ring.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(220)</visible>
                        </control>
                        <control type="image">
                            <left>12</left>
                            <top>16</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true" diffuse="jellyelec-mask-poster.png">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </focusedlayout>
                </control>
            </control>
        </control>

    </controls>
</window>
