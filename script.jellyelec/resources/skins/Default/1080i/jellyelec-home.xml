                <height>64</height>
                <textoffsetx>30</textoffsetx>
                <align>center</align>
                <aligny>center</aligny>
                <font>JE_Label</font>
                <textcolor>FFB7B9C6</textcolor>
                <focusedcolor>FFFFFFFF</focusedcolor>
                <texturefocus border="30,0,30,0">jellyelec-library-focus.png</texturefocus>
                <texturenofocus border="22,0,22,0" colordiffuse="$INFO[Window.Property(library_underline_1001)]">jellyelec-library-underline.png</texturenofocus>
                <ondown>150</ondown>
            </control>
            <control type="button" id="1002">
