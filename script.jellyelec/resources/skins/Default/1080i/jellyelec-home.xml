<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC home screen.
    Control IDs here must match the constants in resources/lib/home.py:
      100  library bar
      200  Continue Watching row
-->
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <backgroundcolor>0xFF101418</backgroundcolor>
    <controls>

        <!-- Backdrop of the focused poster, dimmed so text stays readable -->
        <control type="image">
            <left>760</left>
            <top>0</top>
            <width>1160</width>
            <height>653</height>
            <aspectratio>scale</aspectratio>
            <colordiffuse>59FFFFFF</colordiffuse>
            <fadetime>300</fadetime>
            <texture background="true">$INFO[Container(200).ListItem.Art(fanart)]</texture>
        </control>

        <!-- Library bar -->
        <control type="list" id="100">
            <left>80</left>
            <top>40</top>
            <width>1500</width>
            <height>70</height>
            <orientation>horizontal</orientation>
            <ondown>200</ondown>
            <scrolltime>200</scrolltime>
            <itemlayout width="260" height="70">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>240</width>
                    <height>60</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FF8A93A0</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="260" height="70">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>240</width>
                    <height>60</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="image">
                    <left>60</left>
                    <top>60</top>
                    <width>120</width>
                    <height>4</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FFAA5CC3</colordiffuse>
                    <visible>Control.HasFocus(100)</visible>
                </control>
                <control type="image">
                    <left>60</left>
                    <top>60</top>
                    <width>120</width>
                    <height>4</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FF6B7480</colordiffuse>
                    <visible>!Control.HasFocus(100)</visible>
                </control>
            </focusedlayout>
        </control>

        <!-- Signed-in user, top right -->
        <control type="label">
            <left>1580</left>
            <top>40</top>
            <width>260</width>
            <height>60</height>
            <align>right</align>
            <aligny>center</aligny>
            <textcolor>FF8A93A0</textcolor>
            <label>$INFO[Window.Property(user_name)]</label>
        </control>

        <!-- Spotlight: details of the focused poster -->
        <control type="group">
            <left>80</left>
            <top>170</top>
            <control type="label">
                <left>0</left>
                <top>0</top>
                <width>900</width>
                <height>40</height>
                <textcolor>FF8A93A0</textcolor>
                <label>$INFO[Container(200).ListItem.TVShowTitle]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>40</top>
                <width>900</width>
                <height>70</height>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Container(200).ListItem.Title]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>115</top>
                <width>900</width>
                <height>40</height>
                <textcolor>FFCFD6DE</textcolor>
                <label>$INFO[Container(200).ListItem.Season,Season , · ]$INFO[Container(200).ListItem.Episode,Episode , · ]$INFO[Container(200).ListItem.Year,, · ]$INFO[Container(200).ListItem.Duration(mins),, min]</label>
            </control>
            <control type="textbox">
                <left>0</left>
                <top>165</top>
                <width>820</width>
                <height>200</height>
                <textcolor>FFAAB2BC</textcolor>
                <label>$INFO[Container(200).ListItem.Plot]</label>
            </control>
        </control>

        <!-- Continue Watching row -->
        <control type="label">
            <left>80</left>
            <top>600</top>
            <width>900</width>
            <height>40</height>
            <textcolor>FFFFFFFF</textcolor>
            <label>Continue watching</label>
        </control>
        <control type="label">
            <left>80</left>
            <top>700</top>
            <width>1200</width>
            <height>40</height>
            <textcolor>FF6B7480</textcolor>
            <label>Nothing in progress in this library.</label>
            <visible>Integer.IsEqual(Container(200).NumItems,0)</visible>
        </control>
        <control type="list" id="200">
            <left>70</left>
            <top>650</top>
            <width>1840</width>
            <height>350</height>
            <orientation>horizontal</orientation>
            <onup>100</onup>
            <scrolltime>200</scrolltime>
            <itemlayout width="220" height="350">
                <control type="image">
                    <left>10</left>
                    <top>10</top>
                    <width>200</width>
                    <height>300</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="220" height="350">
                <control type="image">
                    <left>4</left>
                    <top>4</top>
                    <width>212</width>
                    <height>312</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FFAA5CC3</colordiffuse>
                    <visible>Control.HasFocus(200)</visible>
                </control>
                <control type="image">
                    <left>10</left>
                    <top>10</top>
                    <width>200</width>
                    <height>300</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                </control>
            </focusedlayout>
        </control>

        <!-- Footer -->
        <control type="label">
            <left>80</left>
            <top>1020</top>
            <width>1760</width>
            <height>40</height>
            <textcolor>FF4E5560</textcolor>
            <label>JellyELEC $INFO[Window.Property(version)]  ·  Menu (C on a keyboard) to sign out</label>
        </control>

    </controls>
</window>
