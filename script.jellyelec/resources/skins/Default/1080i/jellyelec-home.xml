<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC home screen (v2 look: library bar on top, spotlight, fanart fading in on the right).
    Control IDs here must match the constants in resources/lib/home.py:
      100  library bar (a grouplist of buttons 1001-1012, one per library)
      110  Settings button
      150  scrolling stack of rows
      200  Continue Watching row
      205  Next Up row (TV libraries only)
      210  Recently Added row
      220  Random row
    The spotlight is filled by home.py through window properties (spot_*).
    Fonts named JE_* come with the JellyELEC image; elsewhere Kodi uses its default font.
-->
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <backgroundcolor>0xFF0B0C11</backgroundcolor>
    <controls>

        <!-- Fanart of whatever the spotlight shows, fading into the background on the left and below -->
        <control type="image">
            <left>580</left>
            <top>0</top>
            <width>1340</width>
            <height>760</height>
            <aspectratio>scale</aspectratio>
            <colordiffuse>D9FFFFFF</colordiffuse>
            <fadetime>400</fadetime>
            <texture background="true">$INFO[Window.Property(spot_backdrop)]</texture>
        </control>
        <control type="image">
            <left>580</left>
            <top>0</top>
            <width>1340</width>
            <height>760</height>
            <texture>jellyelec-fade-left.png</texture>
        </control>
        <control type="image">
            <left>0</left>
            <top>420</top>
            <width>1920</width>
            <height>342</height>
            <texture>jellyelec-fade-bottom.png</texture>
        </control>

        <!-- Top bar: wordmark, libraries, weather, clock and Settings -->
        <control type="label">
            <left>96</left>
            <top>40</top>
            <width>200</width>
            <height>64</height>
            <aligny>center</aligny>
            <font>JE_Brand</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>Jelly[COLOR FFAA5CC3]ELEC[/COLOR]</label>
        </control>

        <!-- Library bar: one button per library, sized to its name; library_bar.py fills them
             and hides the spare ones. Focused: a blue pill. The library the rows are from,
             when the bar isn't focused: a blue underline (colour set per button by
             library_bar.py) and white text. Slides along to keep the focused one in view. -->
