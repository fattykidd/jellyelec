<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC home screen.
    Control IDs here must match the constants in resources/lib/home.py:
      100  library bar
      150  scrolling stack of rows
      200  Continue Watching row
      205  Next Up row (TV libraries only)
      210  Recently Added row
      220  Random row
    The spotlight is filled by home.py through window properties (spot_*).
-->
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <backgroundcolor>0xFF101418</backgroundcolor>
    <controls>

        <!-- Backdrop of the focused poster, dimmed so text stays readable -->
        <control type="image">
            <left>760</left>
            <top>0</top>
            <width>1160</width>
            <height>653</height>
            <aspectratio>scale</aspectratio>
            <colordiffuse>59FFFFFF</colordiffuse>
            <fadetime>300</fadetime>
            <texture background="true">$INFO[Window.Property(spot_backdrop)]</texture>
        </control>

        <!-- Library bar -->
        <control type="list" id="100">
            <left>80</left>
            <top>40</top>
            <width>1500</width>
            <height>70</height>
            <orientation>horizontal</orientation>
            <ondown>150</ondown>
            <scrolltime>200</scrolltime>
            <itemlayout width="260" height="70">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>240</width>
                    <height>60</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FF8A93A0</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="260" height="70">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>240</width>
                    <height>60</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="image">
                    <left>60</left>
                    <top>60</top>
                    <width>120</width>
                    <height>4</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FFAA5CC3</colordiffuse>
                    <visible>Control.HasFocus(100)</visible>
                </control>
                <control type="image">
                    <left>60</left>
                    <top>60</top>
                    <width>120</width>
                    <height>4</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FF6B7480</colordiffuse>
                    <visible>!Control.HasFocus(100)</visible>
                </control>
            </focusedlayout>
        </control>

        <!-- Signed-in user, top right -->
        <control type="label">
            <left>1580</left>
            <top>40</top>
            <width>260</width>
            <height>60</height>
            <align>right</align>
            <aligny>center</aligny>
            <textcolor>FF8A93A0</textcolor>
            <label>$INFO[Window.Property(user_name)]</label>
        </control>

        <!-- Spotlight: details of the focused poster -->
        <control type="group">
            <left>80</left>
            <top>150</top>
            <control type="label">
                <left>0</left>
                <top>0</top>
                <width>900</width>
                <height>40</height>
                <textcolor>FF8A93A0</textcolor>
                <label>$INFO[Window.Property(spot_show_title)]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>40</top>
                <width>900</width>
                <height>70</height>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(spot_title)]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>115</top>
                <width>900</width>
                <height>40</height>
                <textcolor>FFCFD6DE</textcolor>
                <label>$INFO[Window.Property(spot_meta)]</label>
            </control>
            <control type="textbox">
                <left>0</left>
                <top>165</top>
                <width>820</width>
                <height>180</height>
                <textcolor>FFAAB2BC</textcolor>
                <label>$INFO[Window.Property(spot_plot)]</label>
            </control>
        </control>

        <!-- Shown when every row is empty -->
        <control type="label">
            <left>80</left>
            <top>600</top>
            <width>1200</width>
            <height>40</height>
            <textcolor>FF6B7480</textcolor>
            <label>Nothing to show in this library yet.</label>
            <visible>Integer.IsEqual(Container(200).NumItems,0) + Integer.IsEqual(Container(205).NumItems,0) + Integer.IsEqual(Container(210).NumItems,0) + Integer.IsEqual(Container(220).NumItems,0)</visible>
        </control>

        <!-- Stack of rows. Scrolls to keep the focused row in view; empty rows are hidden. -->
        <control type="grouplist" id="150">
            <left>0</left>
            <top>530</top>
            <width>1920</width>
            <height>480</height>
            <orientation>vertical</orientation>
            <itemgap>10</itemgap>
            <onup>100</onup>
            <scrolltime>200</scrolltime>

            <control type="group">
                <width>1920</width>
                <height>330</height>
                <visible>Integer.IsGreater(Container(200).NumItems,0)</visible>
                <control type="label">
                    <left>80</left>
                    <top>0</top>
                    <width>900</width>
                    <height>40</height>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>Continue watching</label>
                </control>
                <control type="list" id="200">
                    <onup>100</onup>
                    <ondown>205</ondown>
                    <left>70</left>
                    <top>40</top>
                    <width>1840</width>
                    <height>290</height>
                    <orientation>horizontal</orientation>
                    <scrolltime>200</scrolltime>
                    <itemlayout width="200" height="290">
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout width="200" height="290">
                        <control type="image">
                            <left>4</left>
                            <top>4</top>
                            <width>192</width>
                            <height>282</height>
                            <texture>jellyelec-white.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(200)</visible>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </focusedlayout>
                </control>
            </control>

            <control type="group">
                <width>1920</width>
                <height>330</height>
                <visible>Integer.IsGreater(Container(205).NumItems,0)</visible>
                <control type="label">
                    <left>80</left>
                    <top>0</top>
                    <width>900</width>
                    <height>40</height>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>Next up</label>
                </control>
                <control type="list" id="205">
                    <onup>200</onup>
                    <ondown>210</ondown>
                    <left>70</left>
                    <top>40</top>
                    <width>1840</width>
                    <height>290</height>
                    <orientation>horizontal</orientation>
                    <scrolltime>200</scrolltime>
                    <itemlayout width="200" height="290">
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout width="200" height="290">
                        <control type="image">
                            <left>4</left>
                            <top>4</top>
                            <width>192</width>
                            <height>282</height>
                            <texture>jellyelec-white.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(205)</visible>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </focusedlayout>
                </control>
            </control>

            <control type="group">
                <width>1920</width>
                <height>330</height>
                <visible>Integer.IsGreater(Container(210).NumItems,0)</visible>
                <control type="label">
                    <left>80</left>
                    <top>0</top>
                    <width>900</width>
                    <height>40</height>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>Recently added</label>
                </control>
                <control type="list" id="210">
                    <onup>205</onup>
                    <ondown>220</ondown>
                    <left>70</left>
                    <top>40</top>
                    <width>1840</width>
                    <height>290</height>
                    <orientation>horizontal</orientation>
                    <scrolltime>200</scrolltime>
                    <itemlayout width="200" height="290">
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout width="200" height="290">
                        <control type="image">
                            <left>4</left>
                            <top>4</top>
                            <width>192</width>
                            <height>282</height>
                            <texture>jellyelec-white.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(210)</visible>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </focusedlayout>
                </control>
            </control>

            <control type="group">
                <width>1920</width>
                <height>330</height>
                <visible>Integer.IsGreater(Container(220).NumItems,0)</visible>
                <control type="label">
                    <left>80</left>
                    <top>0</top>
                    <width>900</width>
                    <height>40</height>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>Random</label>
                </control>
                <control type="list" id="220">
                    <onup>210</onup>
                    <left>70</left>
                    <top>40</top>
                    <width>1840</width>
                    <height>290</height>
                    <orientation>horizontal</orientation>
                    <scrolltime>200</scrolltime>
                    <itemlayout width="200" height="290">
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </itemlayout>
                    <focusedlayout width="200" height="290">
                        <control type="image">
                            <left>4</left>
                            <top>4</top>
                            <width>192</width>
                            <height>282</height>
                            <texture>jellyelec-white.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(220)</visible>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>180</width>
                            <height>270</height>
                            <aspectratio>scale</aspectratio>
                            <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                        </control>
                    </focusedlayout>
                </control>
            </control>
        </control>

        <!-- Footer -->
        <control type="label">
            <left>80</left>
            <top>1030</top>
            <width>1760</width>
            <height>40</height>
            <textcolor>FF4E5560</textcolor>
            <label>JellyELEC $INFO[Window.Property(version)]  ·  OK on a library to browse it  ·  Menu (C on a keyboard) to sign out</label>
        </control>

    </controls>
</window>
