<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC episodes screen: season bar along the top, episodes below,
    and the focused episode's picture and details on the right.
    Control IDs here must match the constants in resources/lib/episodes.py:
      600  season bar
      610  episode list
    The right-hand panel is filled by episodes.py through window properties (episode_*).
-->
<window>
    <defaultcontrol always="true">610</defaultcontrol>
    <backgroundcolor>0xFF101418</backgroundcolor>
    <controls>

        <!-- Show backdrop, faint -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <aspectratio>scale</aspectratio>
            <colordiffuse>26FFFFFF</colordiffuse>
            <texture background="true">$INFO[Window.Property(backdrop)]</texture>
        </control>

        <!-- Show name -->
        <control type="label">
            <left>80</left>
            <top>40</top>
            <width>1760</width>
            <height>60</height>
            <aligny>center</aligny>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window.Property(series_name)]</label>
        </control>

        <!-- Season bar -->
        <control type="list" id="600">
            <left>80</left>
            <top>110</top>
            <width>1760</width>
            <height>70</height>
            <orientation>horizontal</orientation>
            <ondown>610</ondown>
            <scrolltime>200</scrolltime>
            <itemlayout width="220" height="70">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>200</width>
                    <height>60</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FF8A93A0</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
            </itemlayout>
            <focusedlayout width="220" height="70">
                <control type="label">
                    <left>0</left>
                    <top>0</top>
                    <width>200</width>
                    <height>60</height>
                    <align>center</align>
                    <aligny>center</aligny>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="image">
                    <left>50</left>
                    <top>60</top>
                    <width>100</width>
                    <height>4</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FFAA5CC3</colordiffuse>
                    <visible>Control.HasFocus(600)</visible>
                </control>
                <control type="image">
                    <left>50</left>
                    <top>60</top>
                    <width>100</width>
                    <height>4</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FF6B7480</colordiffuse>
                    <visible>!Control.HasFocus(600)</visible>
                </control>
            </focusedlayout>
        </control>

        <!-- Episode list -->
        <control type="list" id="610">
            <left>80</left>
            <top>210</top>
            <width>1000</width>
            <height>840</height>
            <orientation>vertical</orientation>
            <onup>600</onup>
            <scrolltime>200</scrolltime>
            <itemlayout width="1000" height="168">
                <control type="image">
                    <left>0</left>
                    <top>12</top>
                    <width>256</width>
                    <height>144</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>290</left>
                    <top>30</top>
                    <width>700</width>
                    <height>40</height>
                    <textcolor>FFCFD6DE</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>290</left>
                    <top>80</top>
                    <width>700</width>
                    <height>36</height>
                    <textcolor>FF6B7480</textcolor>
                    <label>$INFO[ListItem.Property(runtime)]$INFO[ListItem.Property(status),  ·  ,]</label>
                </control>
            </itemlayout>
            <focusedlayout width="1000" height="168">
                <control type="image">
                    <left>-10</left>
                    <top>2</top>
                    <width>1010</width>
                    <height>164</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>1FFFFFFF</colordiffuse>
                    <visible>Control.HasFocus(610)</visible>
                </control>
                <control type="image">
                    <left>-6</left>
                    <top>6</top>
                    <width>268</width>
                    <height>156</height>
                    <texture>jellyelec-white.png</texture>
                    <colordiffuse>FFAA5CC3</colordiffuse>
                    <visible>Control.HasFocus(610)</visible>
                </control>
                <control type="image">
                    <left>0</left>
                    <top>12</top>
                    <width>256</width>
                    <height>144</height>
                    <aspectratio>scale</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="label">
                    <left>290</left>
                    <top>30</top>
                    <width>700</width>
                    <height>40</height>
                    <textcolor>FFFFFFFF</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>290</left>
                    <top>80</top>
                    <width>700</width>
                    <height>36</height>
                    <textcolor>FF8A93A0</textcolor>
                    <label>$INFO[ListItem.Property(runtime)]$INFO[ListItem.Property(status),  ·  ,]</label>
                </control>
            </focusedlayout>
        </control>

        <!-- Focused episode details, on the right -->
        <control type="group">
            <left>1160</left>
            <top>220</top>
            <control type="image">
                <left>0</left>
                <top>0</top>
                <width>680</width>
                <height>383</height>
                <aspectratio>scale</aspectratio>
                <fadetime>200</fadetime>
                <texture background="true">$INFO[Window.Property(episode_thumb)]</texture>
            </control>
            <control type="label">
                <left>0</left>
                <top>405</top>
                <width>680</width>
                <height>50</height>
                <textcolor>FFFFFFFF</textcolor>
                <label>$INFO[Window.Property(episode_title)]</label>
            </control>
            <control type="label">
                <left>0</left>
                <top>455</top>
                <width>680</width>
                <height>40</height>
                <textcolor>FFCFD6DE</textcolor>
                <label>$INFO[Window.Property(episode_meta)]</label>
            </control>
            <control type="textbox">
                <left>0</left>
                <top>505</top>
                <width>680</width>
                <height>320</height>
                <textcolor>FFAAB2BC</textcolor>
                <label>$INFO[Window.Property(episode_plot)]</label>
            </control>
        </control>

    </controls>
</window>
