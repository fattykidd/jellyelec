<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC artwork viewer, opened from a detail page's Artwork button.
    Control IDs here must match the constants in resources/lib/info_panels.py:
      1300  strip of thumbnails; the focused one is shown large above it
-->
<window>
    <defaultcontrol always="true">1300</defaultcontrol>
    <controls>

        <!-- Covers the page underneath -->
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>jellyelec-white.png</texture>
            <colordiffuse>F50B0C11</colordiffuse>
        </control>

        <control type="label">
            <left>96</left>
            <top>60</top>
            <width>1200</width>
            <height>36</height>
            <font>JE_Kicker</font>
            <textcolor>FFAA5CC3</textcolor>
            <label>ARTWORK</label>
        </control>
        <control type="label">
            <left>96</left>
            <top>96</top>
            <width>1500</width>
            <height>80</height>
            <aligny>center</aligny>
            <font>JE_TitleSmall</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>$INFO[Window.Property(title)]</label>
        </control>
        <control type="label">
            <left>1530</left>
            <top>40</top>
            <width>294</width>
            <height>64</height>
            <align>right</align>
            <aligny>center</aligny>
            <font>JE_Clock</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>$INFO[System.Time]</label>
        </control>

        <!-- The focused picture, large -->
        <control type="image">
            <left>96</left>
            <top>190</top>
            <width>1728</width>
            <height>570</height>
            <aspectratio>keep</aspectratio>
            <fadetime>200</fadetime>
            <texture background="true">$INFO[Container(1300).ListItem.Art(full)]</texture>
        </control>

        <!-- What it is: Backdrop 3 of 12  ·  3840 × 2160 -->
        <control type="label">
            <left>96</left>
            <top>772</top>
            <width>1728</width>
            <height>40</height>
            <align>center</align>
            <font>JE_LabelBold</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>$INFO[Container(1300).ListItem.Label]$INFO[Container(1300).ListItem.Property(size),[COLOR FF8D90A0]  ·  ,[/COLOR]]</label>
        </control>

        <control type="list" id="1300">
            <left>84</left>
            <top>830</top>
            <width>1836</width>
            <height>230</height>
            <orientation>horizontal</orientation>
            <scrolltime tween="cubic" easing="out">220</scrolltime>
            <itemlayout width="340" height="230">
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>320</width>
                            <height>200</height>
                            <texture border="18">jellyelec-chip.png</texture>
                        </control>
                        <control type="image">
                            <left>22</left>
                            <top>22</top>
                            <width>296</width>
                            <height>176</height>
                            <aspectratio>keep</aspectratio>
                            <colordiffuse>B3FFFFFF</colordiffuse>
                            <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                        </control>
            </itemlayout>
            <focusedlayout width="340" height="230">
                        <control type="image">
                            <left>2</left>
                            <top>2</top>
                            <width>336</width>
                            <height>216</height>
                            <texture border="18">jellyelec-ring.png</texture>
                            <colordiffuse>FFAA5CC3</colordiffuse>
                            <visible>Control.HasFocus(1300)</visible>
                        </control>
                        <control type="image">
                            <left>10</left>
                            <top>10</top>
                            <width>320</width>
                            <height>200</height>
                            <texture border="18">jellyelec-chip.png</texture>
                        </control>
                        <control type="image">
                            <left>22</left>
                            <top>22</top>
                            <width>296</width>
                            <height>176</height>
                            <aspectratio>keep</aspectratio>
                            <colordiffuse>FFFFFFFF</colordiffuse>
                            <texture background="true">$INFO[ListItem.Art(thumb)]</texture>
                        </control>
            </focusedlayout>
        </control>

    </controls>
</window>
