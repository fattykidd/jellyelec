<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC picker: a list to choose one thing from, as a panel on the right (so a playing
    video stays in view). Used in place of Kodi's select dialog.
    Control IDs here must match the constants in resources/lib/picker.py:
      1400  the options; the current one has a check mark
    The title is filled by picker.py through a window property.
-->
<window>
    <defaultcontrol always="true">1400</defaultcontrol>
    <controls>

        <control type="image">
            <left>1180</left>
            <top>0</top>
            <width>740</width>
            <height>1080</height>
            <texture>jellyelec-white.png</texture>
            <colordiffuse>F00B0C11</colordiffuse>
        </control>

        <control type="label">
            <left>1250</left>
            <top>80</top>
            <width>600</width>
            <height>60</height>
            <aligny>center</aligny>
            <font>JE_Heading</font>
            <textcolor>FFF2F2F5</textcolor>
            <label>$INFO[Window.Property(title)]</label>
        </control>

        <control type="list" id="1400">
            <left>1230</left>
            <top>170</top>
            <width>650</width>
            <height>860</height>
            <orientation>vertical</orientation>
            <scrolltime tween="cubic" easing="out">200</scrolltime>
            <itemlayout width="650" height="90">
                <control type="label">
                    <left>24</left>
                    <top>10</top>
                    <width>540</width>
                    <height>40</height>
                    <aligny>center</aligny>
                    <font>JE_Label</font>
                    <textcolor>FFD5D6DE</textcolor>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>24</left>
                    <top>48</top>
                    <width>540</width>
                    <height>30</height>
                    <font>JE_Small</font>
                    <textcolor>FF8D90A0</textcolor>
                    <label>$INFO[ListItem.Property(detail)]</label>
                </control>
                <control type="image">
                    <left>584</left>
                    <top>27</top>
                    <width>36</width>
                    <height>36</height>
                    <texture>jellyelec-icon-check.png</texture>
                    <colordiffuse>FF00A4DC</colordiffuse>
                    <visible>!String.IsEmpty(ListItem.Property(current))</visible>
                </control>
            </itemlayout>
            <focusedlayout width="650" height="90">
                <control type="image">
                    <left>0</left>
                    <top>4</top>
                    <width>650</width>
                    <height>82</height>
                    <texture border="18">jellyelec-pill.png</texture>
                    <colordiffuse>FF00A4DC</colordiffuse>
                    <visible>Control.HasFocus(1400)</visible>
                </control>
                <control type="label">
                    <left>24</left>
                    <top>10</top>
                    <width>540</width>
                    <height>40</height>
                    <aligny>center</aligny>
                    <font>JE_LabelBold</font>
                    <textcolor>FFFFFFFF</textcolor>
                    <scroll>true</scroll>
                    <label>$INFO[ListItem.Label]</label>
                </control>
                <control type="label">
                    <left>24</left>
                    <top>48</top>
                    <width>540</width>
                    <height>30</height>
                    <font>JE_Small</font>
                    <textcolor>FFE6F6FC</textcolor>
                    <label>$INFO[ListItem.Property(detail)]</label>
                </control>
                <control type="image">
                    <left>584</left>
                    <top>27</top>
                    <width>36</width>
                    <height>36</height>
                    <texture>jellyelec-icon-check.png</texture>
                    <colordiffuse>FFFFFFFF</colordiffuse>
                    <visible>!String.IsEmpty(ListItem.Property(current))</visible>
                </control>
            </focusedlayout>
        </control>

    </controls>
</window>
