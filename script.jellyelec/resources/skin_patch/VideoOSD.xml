<?xml version="1.0" encoding="UTF-8"?>
<!--
    JellyELEC's OSD, in place of the skin's own (JellyELEC copies it in; see skin_patch.py).
    Opened with OK during full-screen video; the seek bar (DialogSeekBar.xml) shows above it.
    Buttons, left to right: Chapters (when the file has them), back 10 seconds, Play/Pause,
    forward 30 seconds, Audio, Subtitles, Player info (Kodi's player process info) and Stop.
    Chapters, Audio and Subtitles ask JellyELEC to open its own panels (key_requests.py).
    Player info shows Kodi's player process info over the faded-out OSD; OK hides it again.
-->
<window>
    <defaultcontrol always="true">103</defaultcontrol>
    <animation effect="fade" time="200">WindowOpen</animation>
    <animation effect="fade" time="200">WindowClose</animation>
    <!-- Player info's stats go when the OSD does -->
    <onunload>Dialog.Close(playerprocessinfo)</onunload>
    <controls>
      <!-- Everything fades out while Player info's stats show (see PROCESS_INFO) -->
      <control type="group">
        <animation effect="fade" start="100" end="0" time="150" condition="Window.IsVisible(playerprocessinfo)">Conditional</animation>

        <!-- Clock, top right, with a little shade behind it -->
        <control type="image">
            <left>1120</left>
            <top>0</top>
            <width>800</width>
            <height>200</height>
            <texture flipy="true">jellyelec-fade-bottom.png</texture>
            <colordiffuse>B3FFFFFF</colordiffuse>
        </control>
        <control type="label">
            <left>1530</left>
            <top>40</top>
            <width>294</width>
            <height>64</height>
            <align>right</align>
            <aligny>center</aligny>
            <font>JE_Clock</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>$INFO[System.Time]</label>
        </control>

        <control type="grouplist" id="100">
            <left>96</left>
            <top>918</top>
            <width>1728</width>
            <height>80</height>
            <orientation>horizontal</orientation>
            <align>center</align>
            <itemgap>24</itemgap>
            <control type="radiobutton" id="101">
                <width>80</width>
                <height>80</height>
                <label></label>
                <texturefocus border="40" colordiffuse="FF00A4DC">jellyelec-pill.png</texturefocus>
                <texturenofocus>jellyelec-osd-button.png</texturenofocus>
                <animation effect="zoom" start="100" end="115" center="auto" time="120" tween="cubic" easing="out">Focus</animation>
                <animation effect="zoom" start="115" end="100" center="auto" time="120" tween="cubic" easing="out">Unfocus</animation>
                <radioposx>20</radioposx>
                <radioposy>20</radioposy>
                <radiowidth>40</radiowidth>
                <radioheight>40</radioheight>
                <textureradioonfocus>jellyelec-osd-chapters.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">jellyelec-osd-chapters.png</textureradioonnofocus>
                <textureradioofffocus>jellyelec-osd-chapters.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FFFFFFFF">jellyelec-osd-chapters.png</textureradiooffnofocus>
                <onclick>SetProperty(script.jellyelec.request,chapters,home)</onclick>
                <onclick>Dialog.Close(videoosd)</onclick>
                <visible>Integer.IsGreater(Player.ChapterCount,1)</visible>
            </control>
            <control type="radiobutton" id="102">
                <width>80</width>
                <height>80</height>
                <label></label>
                <texturefocus border="40" colordiffuse="FF00A4DC">jellyelec-pill.png</texturefocus>
                <texturenofocus>jellyelec-osd-button.png</texturenofocus>
                <animation effect="zoom" start="100" end="115" center="auto" time="120" tween="cubic" easing="out">Focus</animation>
                <animation effect="zoom" start="115" end="100" center="auto" time="120" tween="cubic" easing="out">Unfocus</animation>
                <radioposx>20</radioposx>
                <radioposy>20</radioposy>
                <radiowidth>40</radiowidth>
                <radioheight>40</radioheight>
                <textureradioonfocus>jellyelec-osd-back.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">jellyelec-osd-back.png</textureradioonnofocus>
                <textureradioofffocus>jellyelec-osd-back.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FFFFFFFF">jellyelec-osd-back.png</textureradiooffnofocus>
                <onclick>Seek(-10)</onclick>
            </control>
            <control type="radiobutton" id="103">
                <width>80</width>
                <height>80</height>
                <label></label>
                <texturefocus border="40" colordiffuse="FF00A4DC">jellyelec-pill.png</texturefocus>
                <texturenofocus>jellyelec-osd-button.png</texturenofocus>
                <animation effect="zoom" start="100" end="115" center="auto" time="120" tween="cubic" easing="out">Focus</animation>
                <animation effect="zoom" start="115" end="100" center="auto" time="120" tween="cubic" easing="out">Unfocus</animation>
                <radioposx>20</radioposx>
                <radioposy>20</radioposy>
                <radiowidth>40</radiowidth>
                <radioheight>40</radioheight>
                <textureradioonfocus>jellyelec-osd-play.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">jellyelec-osd-play.png</textureradioonnofocus>
                <textureradioofffocus>jellyelec-osd-pause.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FFFFFFFF">jellyelec-osd-pause.png</textureradiooffnofocus>
                <selected>Player.Paused</selected>
                <onclick>PlayerControl(Play)</onclick>
            </control>
            <control type="radiobutton" id="104">
                <width>80</width>
                <height>80</height>
                <label></label>
                <texturefocus border="40" colordiffuse="FF00A4DC">jellyelec-pill.png</texturefocus>
                <texturenofocus>jellyelec-osd-button.png</texturenofocus>
                <animation effect="zoom" start="100" end="115" center="auto" time="120" tween="cubic" easing="out">Focus</animation>
                <animation effect="zoom" start="115" end="100" center="auto" time="120" tween="cubic" easing="out">Unfocus</animation>
                <radioposx>20</radioposx>
                <radioposy>20</radioposy>
                <radiowidth>40</radiowidth>
                <radioheight>40</radioheight>
                <textureradioonfocus>jellyelec-osd-forward.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">jellyelec-osd-forward.png</textureradioonnofocus>
                <textureradioofffocus>jellyelec-osd-forward.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FFFFFFFF">jellyelec-osd-forward.png</textureradiooffnofocus>
                <onclick>Seek(30)</onclick>
            </control>
            <control type="radiobutton" id="105">
                <width>80</width>
                <height>80</height>
                <label></label>
                <texturefocus border="40" colordiffuse="FF00A4DC">jellyelec-pill.png</texturefocus>
                <texturenofocus>jellyelec-osd-button.png</texturenofocus>
                <animation effect="zoom" start="100" end="115" center="auto" time="120" tween="cubic" easing="out">Focus</animation>
                <animation effect="zoom" start="115" end="100" center="auto" time="120" tween="cubic" easing="out">Unfocus</animation>
                <radioposx>20</radioposx>
                <radioposy>20</radioposy>
                <radiowidth>40</radiowidth>
                <radioheight>40</radioheight>
                <textureradioonfocus>jellyelec-osd-audio.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">jellyelec-osd-audio.png</textureradioonnofocus>
                <textureradioofffocus>jellyelec-osd-audio.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FFFFFFFF">jellyelec-osd-audio.png</textureradiooffnofocus>
                <onclick>SetProperty(script.jellyelec.request,audio,home)</onclick>
                <onclick>Dialog.Close(videoosd)</onclick>
            </control>
            <control type="radiobutton" id="106">
                <width>80</width>
                <height>80</height>
                <label></label>
                <texturefocus border="40" colordiffuse="FF00A4DC">jellyelec-pill.png</texturefocus>
                <texturenofocus>jellyelec-osd-button.png</texturenofocus>
                <animation effect="zoom" start="100" end="115" center="auto" time="120" tween="cubic" easing="out">Focus</animation>
                <animation effect="zoom" start="115" end="100" center="auto" time="120" tween="cubic" easing="out">Unfocus</animation>
                <radioposx>20</radioposx>
                <radioposy>20</radioposy>
                <radiowidth>40</radiowidth>
                <radioheight>40</radioheight>
                <textureradioonfocus>jellyelec-osd-subtitles.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">jellyelec-osd-subtitles.png</textureradioonnofocus>
                <textureradioofffocus>jellyelec-osd-subtitles.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FFFFFFFF">jellyelec-osd-subtitles.png</textureradiooffnofocus>
                <onclick>SetProperty(script.jellyelec.request,subtitles,home)</onclick>
                <onclick>Dialog.Close(videoosd)</onclick>
            </control>
            <control type="radiobutton" id="107">
                <width>80</width>
                <height>80</height>
                <label></label>
                <texturefocus border="40" colordiffuse="FF00A4DC">jellyelec-pill.png</texturefocus>
                <texturenofocus>jellyelec-osd-button.png</texturenofocus>
                <animation effect="zoom" start="100" end="115" center="auto" time="120" tween="cubic" easing="out">Focus</animation>
                <animation effect="zoom" start="115" end="100" center="auto" time="120" tween="cubic" easing="out">Unfocus</animation>
                <radioposx>20</radioposx>
                <radioposy>20</radioposy>
                <radiowidth>40</radiowidth>
                <radioheight>40</radioheight>
                <textureradioonfocus>jellyelec-osd-info.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">jellyelec-osd-info.png</textureradioonnofocus>
                <textureradioofffocus>jellyelec-osd-info.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FFFFFFFF">jellyelec-osd-info.png</textureradiooffnofocus>
                <onclick condition="Window.IsVisible(playerprocessinfo)">Dialog.Close(playerprocessinfo)</onclick>
                <onclick condition="!Window.IsVisible(playerprocessinfo)">ActivateWindow(playerprocessinfo)</onclick>
            </control>
            <control type="radiobutton" id="108">
                <width>80</width>
                <height>80</height>
                <label></label>
                <texturefocus border="40" colordiffuse="FF00A4DC">jellyelec-pill.png</texturefocus>
                <texturenofocus>jellyelec-osd-button.png</texturenofocus>
                <animation effect="zoom" start="100" end="115" center="auto" time="120" tween="cubic" easing="out">Focus</animation>
                <animation effect="zoom" start="115" end="100" center="auto" time="120" tween="cubic" easing="out">Unfocus</animation>
                <radioposx>20</radioposx>
                <radioposy>20</radioposy>
                <radiowidth>40</radiowidth>
                <radioheight>40</radioheight>
                <textureradioonfocus>jellyelec-osd-stop.png</textureradioonfocus>
                <textureradioonnofocus colordiffuse="FFFFFFFF">jellyelec-osd-stop.png</textureradioonnofocus>
                <textureradioofffocus>jellyelec-osd-stop.png</textureradioofffocus>
                <textureradiooffnofocus colordiffuse="FFFFFFFF">jellyelec-osd-stop.png</textureradiooffnofocus>
                <onclick>PlayerControl(Stop)</onclick>
            </control>
        </control>

        <!-- The focused button's name -->
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Chapters</label>
            <visible>Control.HasFocus(101)</visible>
        </control>
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Back 10 seconds</label>
            <visible>Control.HasFocus(102)</visible>
        </control>
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Forward 30 seconds</label>
            <visible>Control.HasFocus(104)</visible>
        </control>
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Audio</label>
            <visible>Control.HasFocus(105)</visible>
        </control>
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Subtitles</label>
            <visible>Control.HasFocus(106)</visible>
        </control>
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Player info</label>
            <visible>Control.HasFocus(107)</visible>
        </control>
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Stop</label>
            <visible>Control.HasFocus(108)</visible>
        </control>
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Play</label>
            <visible>Control.HasFocus(103) + Player.Paused</visible>
        </control>
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>Pause</label>
            <visible>Control.HasFocus(103) + !Player.Paused</visible>
        </control>
      </control>

        <!-- While the stats show: how to hide them -->
        <control type="label">
            <left>560</left>
            <top>1018</top>
            <width>800</width>
            <height>40</height>
            <align>center</align>
            <font>JE_Label</font>
            <shadowcolor>E6000000</shadowcolor>
            <textcolor>FFF2F2F5</textcolor>
            <label>OK hides player info</label>
            <visible>Window.IsVisible(playerprocessinfo)</visible>
        </control>

    </controls>
</window>
