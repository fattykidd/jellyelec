<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<settings>
    <category label="Live TV">
        <setting id="guide_video_corner" type="select" values="Top right|Top left" default="Top right"
                 label="Guide: corner for the live picture"/>
    </category>
    <category label="Setup">
        <setting id="appliance_mode" type="bool" default="true"
                 label="Open JellyELEC when the box starts, and reopen it if it closes"/>
        <setting type="action" label="Run setup again next time JellyELEC starts"
                 action="RunScript(script.jellyelec,reset_setup)"/>
        <!-- Kept by first-run setup; not shown on screen. -->
        <setting id="setup_complete" type="bool" default="false" visible="false"/>
        <setting id="box_connection" type="text" default="" visible="false"/>
        <setting id="dolby_vision_pending" type="bool" default="false" visible="false"/>
    </category>
</settings>
